<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Daybreak</RootNamespace>
    <AssemblyName>Daybreak</AssemblyName>
    <Version>0.5.0</Version>
    <Version Condition="'$(DaybreakVersion)' != ''">$(DaybreakVersion)</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../vendor/Nager.Date/src/Nager.Date/Nager.Date.csproj" />
  </ItemGroup>
</Project>
