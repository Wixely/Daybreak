@using System.Globalization

<section class="schedule-explainer" aria-labelledby="@_headingId">
    <div class="explainer-heading">
        <div>
            <p class="eyebrow">Schedule record</p>
            <h3 id="@_headingId">How this schedule works</h3>
        </div>
        <button class="preview-button" type="button" @onclick="RefreshRequested">Refresh from the form</button>
    </div>
    <div class="explanation-list">
        <p>@Explanation.Recurrence</p>
        @if (!string.IsNullOrWhiteSpace(Explanation.Holiday))
        {
            <p>@Explanation.Holiday</p>
        }
        <p>@Explanation.ShowEarly</p>
        <p>@Explanation.Bleed</p>
        <p>@Explanation.Urgency</p>
    </div>

    @if (Examples.Count > 0)
    {
        <div class="schedule-examples">
            <strong>Concrete examples</strong>
            @foreach (var item in Examples)
            {
                <div class="schedule-example">
                    <span>@ExampleDate(item)</span>
                    @if (!string.IsNullOrWhiteSpace(item.AdjustmentExplanation))
                    {
                        <small>@item.AdjustmentExplanation</small>
                    }
                    @if (item.EffectiveDate is not null)
                    {
                        <small>@TimingSummary(item)</small>
                    }
                </div>
            }
        </div>
    }

    <div class="simulator-heading">
        <div>
            <p class="eyebrow">Three-day simulation</p>
            <h3>What the dashboard shows</h3>
        </div>
        <div class="simulator-navigation" aria-label="Simulation date navigation">
            <button type="button" @onclick="PreviousWindow" aria-label="Previous three days">←</button>
            <label>
                <span>Starts</span>
                <input type="date" value="@_windowStart.ToString("yyyy-MM-dd")" @onchange="SetWindowStart" />
            </label>
            <button type="button" @onclick="NextWindow" aria-label="Next three days">→</button>
        </div>
    </div>

    <div class="simulation-clock">
        <label for="@_sliderId">Simulated time: <strong>@FormatInstant(SimulatedNow)</strong></label>
        <input id="@_sliderId" type="range" min="0" max="@WindowMinutes" step="15"
               @bind="_minuteOffset" @bind:event="oninput" />
    </div>

    <div class="timeline" role="group" aria-label="Occurrence visibility, urgency, deadlines, and bleed over three days">
        <div class="timeline-days">
            @foreach (var day in DayColumns)
            {
                <div style="@Position(day.Start, day.End)">
                    <strong>@day.Date.ToString("ddd")</strong>
                    <span>@day.Date.ToString("d MMM")</span>
                    @if (day.Hours != 24)
                    {
                        <small>@day.Hours-hour day</small>
                    }
                </div>
            }
        </div>
        <div class="timeline-body" role="list">
            <span class="timeline-now" style="@NowPosition" aria-hidden="true"></span>
            @if (TimelineItems.Count == 0)
            {
                <p class="timeline-empty">No occurrence is visible or scheduled in this window.</p>
            }
            @foreach (var item in TimelineItems)
            {
                <div class="timeline-row" role="listitem" aria-label="@RowLabel(item)">
                    <div class="timeline-row-label">
                        <strong>@Title</strong>
                        <span>@OccurrenceLabel(item)</span>
                    </div>
                    <div class="timeline-track">
                        @foreach (var segment in Segments(item))
                        {
                            <span class="timeline-segment @segment.ClassName" style="@Position(segment.Start, segment.End)" title="@segment.Label"></span>
                        }
                        @if (item.Deadline is not null)
                        {
                            <span class="timeline-marker deadline" style="left:@Percent(item.Deadline.Value)%" title="Deadline @FormatInstant(item.Deadline.Value)"></span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="timeline-legend" aria-label="Timeline legend">
        <span class="available">Available</span><span class="urgent">Urgent</span><span class="overdue">Past deadline</span><span class="bleed">Bleed</span>
    </div>

    <div class="simulated-cards" aria-live="polite">
        @for (var slot = 0; slot < MaximumVisibleCards; slot++)
        {
            var item = CurrentItems.ElementAtOrDefault(slot);
            var showEmptyState = item is null && slot == 0;
            <div class="simulated-card @(item is null ? showEmptyState ? "hidden" : "empty-slot" : CardClass(item))"
                 aria-hidden="@(item is null && !showEmptyState ? "true" : null)" @key="slot">
                @if (item is null)
                {
                    <span>Not on the dashboard</span>
                    <strong>@Title</strong>
                    <small>Move the simulated time to see when an occurrence appears.</small>
                }
                else
                {
                    <span>@StateAt(item)</span>
                    <strong>@Title</strong>
                    <small>Occurrence from @item.NominalDate.ToString("ddd d MMM"); action window ends @FormatInstant(item.ActionWindowEnd!.Value).</small>
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "Activity";
    [Parameter, EditorRequired] public string TimeZoneId { get; set; } = "UTC";
    [Parameter, EditorRequired] public ScheduleExplanation Explanation { get; set; } = new("", "", "", "", "");
    [Parameter, EditorRequired] public IReadOnlyList<ScheduleProjectionItem> Items { get; set; } = [];
    [Parameter] public DateOnly InitialWindowStart { get; set; }
    [Parameter] public EventCallback RefreshRequested { get; set; }

    private readonly string _headingId = $"schedule-explanation-{Guid.NewGuid():N}";
    private readonly string _sliderId = $"schedule-slider-{Guid.NewGuid():N}";
    private DateOnly _windowStart;
    private DateOnly _observedInitialStart;
    private int _minuteOffset;

    protected override void OnParametersSet()
    {
        if (_windowStart == default || InitialWindowStart != _observedInitialStart)
        {
            _windowStart = InitialWindowStart == default ? DateOnly.FromDateTime(DateTime.UtcNow) : InitialWindowStart;
            _observedInitialStart = InitialWindowStart;
            _minuteOffset = 12 * 60;
        }
    }

    private TimeZoneInfo TimeZone => TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId);
    private DateTimeOffset WindowStart => LocalTimeResolver.Resolve(_windowStart, TimeOnly.MinValue, TimeZone);
    private DateTimeOffset WindowEnd => LocalTimeResolver.Resolve(_windowStart.AddDays(3), TimeOnly.MinValue, TimeZone);
    private int WindowMinutes => Math.Max(1, (int)(WindowEnd - WindowStart).TotalMinutes);
    private DateTimeOffset SimulatedNow => WindowStart.AddMinutes(Math.Min(_minuteOffset, WindowMinutes));

    private IReadOnlyList<ScheduleProjectionItem> Examples => Items
        .Where(item => !string.IsNullOrWhiteSpace(item.AdjustmentExplanation))
        .Take(3)
        .DefaultIfEmpty(Items.FirstOrDefault())
        .Where(item => item is not null)
        .Cast<ScheduleProjectionItem>()
        .ToList();

    private IReadOnlyList<ScheduleProjectionItem> TimelineItems => Items
        .Where(item => item.EffectiveDate is null
            ? item.NominalDate >= _windowStart && item.NominalDate < _windowStart.AddDays(3)
            : item.VisibleFrom < WindowEnd && item.ActionWindowEnd > WindowStart)
        .OrderBy(item => item.VisibleFrom ?? DateTimeOffset.MaxValue)
        .ThenBy(item => item.NominalDate)
        .ToList();

    private IReadOnlyList<DayColumn> DayColumns => Enumerable.Range(0, 3).Select(offset =>
    {
        var date = _windowStart.AddDays(offset);
        var start = LocalTimeResolver.Resolve(date, TimeOnly.MinValue, TimeZone);
        var end = LocalTimeResolver.Resolve(date.AddDays(1), TimeOnly.MinValue, TimeZone);
        return new DayColumn(date, start, end, (int)(end - start).TotalHours);
    }).ToList();

    private IReadOnlyList<ScheduleProjectionItem> CurrentItems => TimelineItems
        .Where(item => item.VisibleFrom <= SimulatedNow && item.ActionWindowEnd > SimulatedNow)
        .OrderByDescending(item => item.NominalDate)
        .ToList();

    private int MaximumVisibleCards
    {
        get
        {
            var events = TimelineItems
                .Where(item => item.VisibleFrom is not null && item.ActionWindowEnd is not null)
                .SelectMany(item => new[]
                {
                    new VisibilityEvent(Max(item.VisibleFrom!.Value, WindowStart), 1),
                    new VisibilityEvent(Min(item.ActionWindowEnd!.Value, WindowEnd), -1),
                })
                .OrderBy(item => item.At)
                .ThenBy(item => item.Change)
                .ToList();
            var visible = 0;
            var maximum = 0;
            foreach (var item in events)
            {
                visible += item.Change;
                maximum = Math.Max(maximum, visible);
            }
            return Math.Max(1, maximum);
        }
    }

    private string StateAt(ScheduleProjectionItem item)
    {
        if (item.EffectiveDayEnd <= SimulatedNow) return "From yesterday · bleed";
        if (item.Deadline <= SimulatedNow) return item.UrgentFrom is null ? "Past deadline" : "Urgent · overdue";
        if (item.UrgentFrom <= SimulatedNow) return "Urgent · due soon";
        return item.NominalDate != item.EffectiveDate ? "Available · moved" : "Available";
    }

    private string CardClass(ScheduleProjectionItem item) => StateAt(item) switch
    {
        var state when state.Contains("Urgent", StringComparison.Ordinal) => "urgent",
        var state when state.Contains("Past deadline", StringComparison.Ordinal) => "overdue",
        var state when state.Contains("bleed", StringComparison.Ordinal) => "bleed",
        var state when state.StartsWith("Available", StringComparison.Ordinal) => "available",
        _ => "hidden",
    };

    private IEnumerable<TimelineSegment> Segments(ScheduleProjectionItem item)
    {
        if (item.EffectiveDate is null || item.VisibleFrom is null || item.ActionWindowEnd is null || item.EffectiveDayEnd is null)
        {
            yield break;
        }

        var visibleFrom = item.VisibleFrom.Value;
        var dayEnd = item.EffectiveDayEnd.Value;
        if (item.Deadline is null)
        {
            yield return new(visibleFrom, dayEnd, "available", "Available");
        }
        else
        {
            var deadline = item.Deadline.Value;
            var warningStart = item.UrgentFrom is not null && item.UrgentFrom < deadline
                ? item.UrgentFrom
                : null;
            var availableEnd = warningStart ?? deadline;
            if (availableEnd > visibleFrom)
            {
                yield return new(visibleFrom, Min(availableEnd, dayEnd), "available", "Available");
            }
            if (warningStart is not null && deadline > visibleFrom)
            {
                yield return new(Max(warningStart.Value, visibleFrom), Min(deadline, dayEnd), "urgent", "Urgent before deadline");
            }
            if (deadline < dayEnd)
            {
                yield return new(Max(deadline, visibleFrom), dayEnd, "overdue", "Past deadline");
            }
        }
        if (item.ActionWindowEnd > item.EffectiveDayEnd)
        {
            yield return new(item.EffectiveDayEnd.Value, item.ActionWindowEnd.Value, "bleed", "Bleed after midnight");
        }
    }

    private void PreviousWindow() { _windowStart = _windowStart.AddDays(-3); _minuteOffset = 12 * 60; }
    private void NextWindow() { _windowStart = _windowStart.AddDays(3); _minuteOffset = 12 * 60; }
    private void SetWindowStart(ChangeEventArgs args)
    {
        if (DateOnly.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _windowStart = date;
            _minuteOffset = 12 * 60;
        }
    }

    private string ExampleDate(ScheduleProjectionItem item) => item.EffectiveDate switch
    {
        null => $"{item.NominalDate:yyyy-MM-dd} → not generated",
        var effective when effective != item.NominalDate => $"{item.NominalDate:yyyy-MM-dd} → {effective:yyyy-MM-dd}",
        var effective => effective.Value.ToString("yyyy-MM-dd"),
    };

    private string TimingSummary(ScheduleProjectionItem item) =>
        $"Visible {FormatInstant(item.VisibleFrom!.Value)} · " +
        (item.UrgentFrom is null ? "No urgency start · " : $"Urgent {FormatInstant(item.UrgentFrom.Value)} · ") +
        (item.Deadline is null ? "No deadline · " : $"Deadline {FormatInstant(item.Deadline.Value)} · ") +
        $"Ends {FormatInstant(item.ActionWindowEnd!.Value)}";

    private string OccurrenceLabel(ScheduleProjectionItem item) => item.EffectiveDate switch
    {
        null => $"{item.NominalDate:ddd d MMM} · suppressed",
        var effective when effective != item.NominalDate => $"{item.NominalDate:ddd d MMM} → {effective:ddd d MMM}",
        _ => item.NominalDate.ToString("ddd d MMM"),
    };

    private string RowLabel(ScheduleProjectionItem item) => item.EffectiveDate is null
        ? $"{Title}, {OccurrenceLabel(item)}. {item.AdjustmentExplanation}"
        : $"{Title}, {OccurrenceLabel(item)}. {TimingSummary(item)}";
    private string FormatInstant(DateTimeOffset instant) => TimeZoneInfo.ConvertTime(instant, TimeZone).ToString("ddd d MMM HH:mm", CultureInfo.InvariantCulture);
    private string Position(DateTimeOffset start, DateTimeOffset end) => $"left:{Percent(start)}%;width:{Math.Max(0, PercentValue(end) - PercentValue(start)).ToString("0.###", CultureInfo.InvariantCulture)}%";
    private string NowPosition => $"left:calc(10rem + (100% - 10rem) * {(PercentValue(SimulatedNow) / 100).ToString("0.#####", CultureInfo.InvariantCulture)})";
    private string Percent(DateTimeOffset instant) => PercentValue(instant).ToString("0.###", CultureInfo.InvariantCulture);
    private double PercentValue(DateTimeOffset instant) => Math.Clamp((instant - WindowStart).TotalMinutes / WindowMinutes, 0, 1) * 100;
    private static DateTimeOffset Min(DateTimeOffset first, DateTimeOffset second) => first <= second ? first : second;
    private static DateTimeOffset Max(DateTimeOffset first, DateTimeOffset second) => first >= second ? first : second;

    private sealed record TimelineSegment(DateTimeOffset Start, DateTimeOffset End, string ClassName, string Label);
    private sealed record DayColumn(DateOnly Date, DateTimeOffset Start, DateTimeOffset End, int Hours);
    private sealed record VisibilityEvent(DateTimeOffset At, int Change);
}
