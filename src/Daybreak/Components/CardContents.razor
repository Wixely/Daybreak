@using Daybreak.Domain
@using System.Globalization

<div class="activity-card-topline">
    <div class="status-badges">
        @if (Item.IsCarried(Today))
        {
            <span class="status-badge carried">From yesterday</span>
        }
        else if (Item.State == OccurrenceState.Completed)
        {
            <span class="status-badge complete">Complete</span>
        }
        else if (Item.IsOverdue(Now))
        {
            <span class="status-badge @(Item.IsUrgent(Now) ? "overdue" : "past")">Past deadline</span>
        }
        else if (Item.IsDueSoon(Now))
        {
            <span class="status-badge soon">Due soon</span>
        }
        else
        {
            <span class="status-badge todo">To do</span>
        }
        @if (Item.NominalDate != Item.EffectiveDate)
        {
            <span class="status-badge moved">Moved from @Item.NominalDate.ToString("d MMM")</span>
        }
    </div>
    @if (Item.Deadline is not null)
    {
        <div class="deadline-display">
            @if (CountdownProgress is { } progress)
            {
                <span class="deadline-countdown @(progress >= 1 ? "exhausted" : null)" style="@CountdownStyle(progress)" role="img"
                      aria-label="@CountdownLabel"></span>
            }
            <time datetime="@Item.Deadline.Value.ToString("O")">@FormatTime(Item.Deadline.Value)</time>
        </div>
    }
</div>
<h2>@Item.Title</h2>
@if (!string.IsNullOrWhiteSpace(Item.Notes))
{
    <p>@Item.Notes</p>
}
<div class="activity-card-footer">
    @if (Item.State == OccurrenceState.Completed)
    {
        <span class="completion-mark" aria-hidden="true">✓</span>
        <span>Done @(Item.CompletedAt is null ? string.Empty : FormatTime(Item.CompletedAt.Value))</span>
    }
    else
    {
        <span>@Item.ScheduleLabel</span>
        <span class="tap-arrow" aria-hidden="true">→</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public BoardItem Item { get; set; } = default!;

    [Parameter]
    public DateOnly Today { get; set; }

    [Parameter]
    public DateTimeOffset Now { get; set; }

    [Parameter, EditorRequired]
    public string TimeZoneId { get; set; } = "UTC";

    private string FormatTime(DateTimeOffset instant) =>
        TimeZoneInfo.ConvertTime(instant, TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId)).ToString("HH:mm");

    private double? CountdownProgress => Item.State == OccurrenceState.Pending
        ? DeadlineCountdown.Progress(Now, Item.Deadline)
        : null;

    private string CountdownLabel
    {
        get
        {
            var remaining = Item.Deadline!.Value - Now;
            if (remaining <= TimeSpan.Zero)
            {
                return "Deadline reached";
            }

            var minutes = (int)Math.Ceiling(remaining.TotalMinutes);
            return $"{minutes} minute{(minutes == 1 ? string.Empty : "s")} until deadline";
        }
    }

    private static string CountdownStyle(double progress) =>
        $"--countdown-progress: {(progress * 360).ToString("0.###", CultureInfo.InvariantCulture)}deg";
}
