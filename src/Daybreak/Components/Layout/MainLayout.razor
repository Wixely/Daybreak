@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <a class="brand" href="/" aria-label="Daybreak dashboard">
            <span class="brand-mark" aria-hidden="true">◐</span>
            <span>Daybreak</span>
        </a>
        <nav aria-label="Primary navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Today</NavLink>
            <NavLink href="/admin">Configure</NavLink>
        </nav>
    </header>
    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui" role="alert">
    Daybreak lost its connection. <a href="." class="reload">Reload</a>
</div>
