@page "/admin/login"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>Administrator sign in · Daybreak</PageTitle>

<section class="auth-card">
    <p class="eyebrow">Configuration</p>
    <h1>Administrator sign in</h1>
    <p>Enter the Daybreak administration password.</p>
    @if (Invalid)
    {
        <div class="alert alert-error" role="alert">That password was not accepted.</div>
    }
    <form method="post" action="/auth/login">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
        <button class="button button-primary" type="submit">Sign in</button>
    </form>
    <a class="text-link" href="/">Return to dashboard</a>
</section>

@code {
    [SupplyParameterFromQuery(Name = "invalid")]
    public bool Invalid { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? RequestedReturnUrl { get; set; }

    private string ReturnUrl => string.IsNullOrWhiteSpace(RequestedReturnUrl) ? "/admin" : RequestedReturnUrl;
}
