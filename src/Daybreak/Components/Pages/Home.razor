@page "/"
@layout DashboardLayout
@implements IAsyncDisposable
@inject BoardService Board
@inject BoardChangeNotifier Changes
@inject TimeProvider Clock
@inject ILogger<Home> Logger
@inject IJSRuntime JavaScript
@using Microsoft.JSInterop

<PageTitle>Today · Daybreak</PageTitle>

<div class="dashboard-primary">
<section class="dashboard-heading">
    <div>
        <h1>@(_snapshot?.Today.ToString("dddd, d MMMM") ?? "Loading…")</h1>
        <p class="lede dashboard-clock">
            <time datetime="@CurrentLocalTime.ToString("O")">@CurrentLocalTime.ToString("HH:mm")</time>
        </p>
    </div>
    <div class="dashboard-heading-controls">
        <button class="button button-secondary dashboard-fullscreen-button" type="button" hidden
                @ref="_fullscreenButton" aria-label="Open Daybreak in full screen">
            Full screen
        </button>
        <div class="connection-pill connected" role="status" title="Revision @(_snapshot?.Revision ?? 0)">
            <span aria-hidden="true"></span> Live
        </div>
    </div>
</section>

@if (_error is not null)
{
    <section class="empty-state error-state" role="alert">
        <p class="eyebrow">Could not load the board</p>
        <h2>Daybreak hit a cloud.</h2>
        <p>@_error</p>
        <button class="button button-primary" @onclick="RefreshAsync">Try again</button>
    </section>
}
else if (_snapshot is null)
{
    <section class="loading-state" aria-label="Loading today's activities">
        <span></span><span></span><span></span>
    </section>
}
else if (_snapshot.Items.Count == 0 && !_exitingItems.Any(item => item.Item.State == OccurrenceState.Pending))
{
    <section class="empty-state">
        <p class="eyebrow">All clear</p>
        <h2>Nothing needs attention</h2>
        <p>Add a recurring activity or one-off task from configuration.</p>
        <a class="button button-primary" href="/admin">Configure Daybreak</a>
    </section>
}
else
{
    <section class="activity-grid pending-activities" aria-label="Activities to do" aria-busy="@_refreshing">
        @foreach (var card in CardsFor(OccurrenceState.Pending))
        {
            var item = card.Item;
            var now = Clock.GetUtcNow();
            var busy = _working.Contains(item.Id);
            <article class="@PresentedCardClass(card, now)"
                     aria-hidden="@(card.IsExiting ? "true" : null)" @key="card.Key">
                @if (card.IsExiting)
                {
                    <div class="activity-action">
                        <CardContents Item="item" Today="_snapshot.Today" Now="now" TimeZoneId="@_snapshot.TimeZoneId" />
                    </div>
                }
                else
                {
                    <button class="activity-action" disabled="@busy" @onclick="() => CompleteAsync(item)"
                            aria-label="Mark @item.Title complete">
                        <CardContents Item="item" Today="_snapshot.Today" Now="now" TimeZoneId="@_snapshot.TimeZoneId" />
                    </button>
                }
            </article>
        }
    </section>
}
</div>

@if (_error is null && _snapshot is not null &&
    (_snapshot.Items.Any(item => item.State == OccurrenceState.Completed) ||
     _exitingItems.Any(item => item.Item.State == OccurrenceState.Completed)))
{
    <section class="completed-activities" aria-label="Completed activities" @ref="_completedSection">
        <div class="activity-grid">
            @foreach (var card in CardsFor(OccurrenceState.Completed))
            {
                var item = card.Item;
                var now = Clock.GetUtcNow();
                var busy = _working.Contains(item.Id);
                <article class="@PresentedCardClass(card, now)"
                         aria-hidden="@(card.IsExiting ? "true" : null)" @key="card.Key">
                    <div class="activity-action completed-content">
                        <CardContents Item="item" Today="_snapshot.Today" Now="now" TimeZoneId="@_snapshot.TimeZoneId" />
                    </div>
                    @if (!card.IsExiting)
                    {
                        <button class="undo-button" disabled="@busy" @onclick="() => UndoAsync(item)">Undo</button>
                    }
                </article>
            }
        </div>
    </section>
}

@code {
    private readonly HashSet<string> _working = [];
    private readonly List<ExitingCard> _exitingItems = [];
    private readonly CancellationTokenSource _disposeToken = new();
    private BoardSnapshot? _snapshot;
    private string? _error;
    private bool _refreshing;
    private long _requestedRevision;
    private Task? _clockTask;
    private ElementReference _completedSection;
    private ElementReference _fullscreenButton;
    private IJSObjectReference? _dashboardModule;
    private string? _observedCompletedItems;
    private bool _dashboardBehaviorStarted;
    private long _transitionSequence;

    private DateTimeOffset CurrentLocalTime => _snapshot is null
        ? Clock.GetUtcNow()
        : TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), TimeZoneInfo.FindSystemTimeZoneById(_snapshot.TimeZoneId));

    protected override async Task OnInitializedAsync()
    {
        Changes.Changed += HandleBoardChangedAsync;
        await RefreshAsync();
        _clockTask = RunClockAsync(_disposeToken.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _dashboardModule ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./dashboard.js");
        if (!_dashboardBehaviorStarted)
        {
            await _dashboardModule.InvokeVoidAsync("startIdleScroll", 60_000);
            await _dashboardModule.InvokeVoidAsync("initializeKeepAwake");
            await _dashboardModule.InvokeVoidAsync("bindFullscreenButton", _fullscreenButton);
            _dashboardBehaviorStarted = true;
        }

        var completedItems = _error is null
            ? _snapshot?.Items.Where(item => item.State == OccurrenceState.Completed).ToList() ?? []
            : [];
        var completedSignature = string.Join('|', completedItems.Select(item => item.Id));

        if (completedItems.Count > 0 && completedSignature != _observedCompletedItems)
        {
            await _dashboardModule.InvokeVoidAsync("observeCompletedSection", _completedSection);
            _observedCompletedItems = completedSignature;
        }
        else if (completedItems.Count == 0 && _observedCompletedItems is not null)
        {
            await _dashboardModule.InvokeVoidAsync("disconnectCompletedSection");
            _observedCompletedItems = null;
        }
    }

    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        try
        {
            do
            {
                var nextSnapshot = await Board.GetSnapshotAsync(_disposeToken.Token);
                CaptureOutgoingCards(_snapshot, nextSnapshot);
                _snapshot = nextSnapshot;
                _error = null;
            }
            while (_snapshot.Revision < _requestedRevision);
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not refresh the Daybreak dashboard.");
            _error = "The board could not be refreshed. Check the connection and try again.";
        }
        finally
        {
            _refreshing = false;
        }
    }

    private Task HandleBoardChangedAsync(long revision) => InvokeAsync(async () =>
    {
        _requestedRevision = Math.Max(_requestedRevision, revision);
        if (_snapshot is null || revision > _snapshot.Revision)
        {
            await RefreshAsync();
            StateHasChanged();
        }
    });

    private async Task CompleteAsync(BoardItem item) => await MutateAsync(
        item,
        () => Board.CompleteAsync(item.Id, item.Version, _disposeToken.Token));

    private async Task UndoAsync(BoardItem item) => await MutateAsync(
        item,
        () => Board.UndoAsync(item.Id, item.Version, _disposeToken.Token));

    private async Task MutateAsync(BoardItem item, Func<Task<bool>> command)
    {
        if (!_working.Add(item.Id))
        {
            return;
        }

        try
        {
            await command();
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not update occurrence {OccurrenceId} from the dashboard.", item.Id);
            _error = "That change could not be saved. Check the connection and try again.";
        }
        finally
        {
            _working.Remove(item.Id);
        }
    }

    private async Task RunClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void CaptureOutgoingCards(BoardSnapshot? previous, BoardSnapshot current)
    {
        if (previous is null)
        {
            return;
        }

        var currentItems = current.Items.ToDictionary(item => item.Id, StringComparer.Ordinal);
        var outgoing = previous.Items
            .Where(item => !currentItems.TryGetValue(item.Id, out var replacement) || replacement.State != item.State)
            .ToList();
        if (outgoing.Count == 0)
        {
            return;
        }

        var keys = new List<string>(outgoing.Count);
        foreach (var item in outgoing)
        {
            _exitingItems.RemoveAll(existing => existing.Item.Id == item.Id && existing.Item.State == item.State);
            var key = $"{item.Id}-exit-{++_transitionSequence}";
            _exitingItems.Add(new ExitingCard(item, key));
            keys.Add(key);
        }

        _ = RemoveExitingCardsAsync(keys);
    }

    private async Task RemoveExitingCardsAsync(IReadOnlyCollection<string> keys)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(420), _disposeToken.Token);
            await InvokeAsync(() =>
            {
                _exitingItems.RemoveAll(item => keys.Contains(item.Key, StringComparer.Ordinal));
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
    }

    private static string CardClass(BoardItem item, DateTimeOffset now)
    {
        var classes = new List<string> { "activity-card" };
        if (item.State == OccurrenceState.Completed)
        {
            classes.Add("completed");
        }
        else if (item.IsOverdue(now))
        {
            classes.Add(item.IsUrgent(now) ? "urgent overdue" : "pending past-deadline");
        }
        else if (item.IsDueSoon(now))
        {
            classes.Add("urgent due-soon");
        }
        else
        {
            classes.Add("pending");
        }

        return string.Join(' ', classes);
    }

    private IEnumerable<PresentedCard> CardsFor(OccurrenceState state)
    {
        if (_snapshot is null)
        {
            return [];
        }

        var now = Clock.GetUtcNow();
        return _snapshot.Items
            .Where(item => item.State == state)
            .Select(item => new PresentedCard(item, item.Id, false))
            .Concat(_exitingItems
                .Where(item => item.Item.State == state)
                .Select(item => new PresentedCard(item.Item, item.Key, true)))
            .OrderBy(card => PresentationBucket(card.Item, now))
            .ThenBy(card => card.Item.Deadline ?? DateTimeOffset.MaxValue)
            .ThenBy(card => card.Item.Title, StringComparer.OrdinalIgnoreCase);
    }

    private static int PresentationBucket(BoardItem item, DateTimeOffset now) => item.State switch
    {
        OccurrenceState.Pending when item.IsOverdue(now) => 0,
        OccurrenceState.Pending when item.Deadline is not null => 1,
        OccurrenceState.Pending => 2,
        _ => 3,
    };

    private static string PresentedCardClass(PresentedCard card, DateTimeOffset now) => card.IsExiting
        ? $"{CardClass(card.Item, now)} exiting-card {(card.Item.State == OccurrenceState.Pending ? "exiting-to-completed" : "exiting-to-pending")}"
        : CardClass(card.Item, now);

    private sealed record ExitingCard(BoardItem Item, string Key);
    private sealed record PresentedCard(BoardItem Item, string Key, bool IsExiting);

    public async ValueTask DisposeAsync()
    {
        Changes.Changed -= HandleBoardChangedAsync;
        await _disposeToken.CancelAsync();
        if (_clockTask is not null)
        {
            await _clockTask;
        }

        if (_dashboardModule is not null)
        {
            try
            {
                await _dashboardModule.InvokeVoidAsync("stopDashboardBehavior");
                await _dashboardModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _disposeToken.Dispose();
    }
}
